---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import BookingPanel from "../components/booking/BookingPanel.astro";
import Footer from "../components/Footer.astro";
import { t } from "../i18n/translations";

const i18n = t("es");
---

<Layout title={i18n.booking.pageTitle} description={i18n.booking.pageDescription}>
  <main>
    <Header lang="es" />
    <section data-booking-surface class="bg-brand-cream">
      <BookingPanel lang="es" headingTag="h1" loading="eager" />
    </section>
    <Footer lang="es" />
  </main>
</Layout>
