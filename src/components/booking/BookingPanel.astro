---
import BookingWidget from "./BookingWidget.astro";
import { PHONE } from "../../lib/booking";
import { t } from "../../i18n/translations";

interface Props {
  lang?: string;
  headingTag?: "h1" | "h2";
  loading?: "eager" | "lazy";
}

const { lang = "es", headingTag: Heading = "h2", loading } = Astro.props;
const i18n = t(lang);
---

<div
  class="mx-auto w-full max-w-[720px] px-4 sm:px-6 py-8 sm:py-12 md:py-16 xxl:py-24 xxxl:py-32 text-brand-brown"
>
  <Heading
    class="text-xl sm:text-2xl md:text-3xl xxl:text-5xl xxxl:text-6xl font-bold tracking-wide text-center"
  >
    {i18n.booking.heading}
  </Heading>
  <p class="mt-3 sm:mt-4 xxl:mt-6 text-sm sm:text-base md:text-lg xxl:text-3xl xxxl:text-4xl text-center">
    {i18n.booking.intro}
  </p>
  <div class="mt-6 sm:mt-8 xxl:mt-12 overflow-hidden rounded-xl bg-white">
    <BookingWidget lang={lang} loading={loading} />
  </div>
  <p class="mt-6 sm:mt-8 xxl:mt-12 text-xs sm:text-sm md:text-base xxl:text-2xl xxxl:text-3xl text-center">
    {i18n.booking.phoneNote}{" "}
    <a
      class="font-bold whitespace-nowrap transition-opacity duration-200 hover:opacity-60"
      href={PHONE.href}
    >
      {PHONE.label}
    </a>
  </p>
</div>
