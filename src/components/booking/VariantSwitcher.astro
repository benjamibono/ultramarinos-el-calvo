---
// DEV ONLY: lets the owner compare booking variants on localhost.
// Rendered from Layout.astro only in dev. Delete this file (and its line
// in Layout.astro) once a variant is chosen.
import { BOOKING, BOOKING_VARIANTS } from "../../lib/booking";

const groups = Object.entries(BOOKING_VARIANTS) as [keyof typeof BOOKING, string[]][];
---

<script is:inline define:vars={{ defaults: BOOKING, variants: BOOKING_VARIANTS }}>
  (() => {
    const KEY = "booking-variants";
    let stored = {};
    try {
      stored = JSON.parse(sessionStorage.getItem(KEY) || "{}");
    } catch {}
    const params = new URLSearchParams(location.search);
    const chosen = {};
    for (const group of Object.keys(variants)) {
      const value = params.get(group) || stored[group];
      chosen[group] = variants[group].includes(value) ? value : defaults[group];
      document.documentElement.dataset[group] = chosen[group];
    }
    const save = () => {
      try {
        sessionStorage.setItem(KEY, JSON.stringify(chosen));
      } catch {}
    };
    save();

    const withParams = (href) => {
      const url = new URL(href, location.href);
      if (url.origin !== location.origin || url.pathname.startsWith("/admin")) return null;
      for (const [group, value] of Object.entries(chosen)) url.searchParams.set(group, value);
      return url.pathname + url.search + url.hash;
    };

    document.addEventListener("DOMContentLoaded", () => {
      // Booking links follow the chosen "reserva" variant
      const key = "href" + chosen.reserva[0].toUpperCase() + chosen.reserva.slice(1);
      document.querySelectorAll("[data-booking-link]").forEach((a) => {
        a.setAttribute("href", a.dataset[key]);
        if (chosen.reserva === "external") {
          a.setAttribute("target", "_blank");
          a.setAttribute("rel", "noopener noreferrer");
        } else {
          a.removeAttribute("target");
          a.removeAttribute("rel");
        }
      });
      // Carry the variants through internal links
      document.querySelectorAll("a[href]").forEach((a) => {
        const next = withParams(a.getAttribute("href"));
        if (next) a.setAttribute("href", next);
      });
      history.replaceState(history.state, "", withParams(location.href));

      const panel = document.querySelector("[data-variant-switcher]");
      panel?.querySelectorAll("select").forEach((select) => {
        select.value = chosen[select.name];
        select.addEventListener("change", () => {
          chosen[select.name] = select.value;
          save();
          location.href = withParams(location.href);
        });
      });
      panel?.querySelector("[data-variant-reset]")?.addEventListener("click", () => {
        try {
          sessionStorage.removeItem(KEY);
        } catch {}
        const url = new URL(location.href);
        for (const group of Object.keys(variants)) url.searchParams.delete(group);
        location.href = url.pathname + url.search + url.hash;
      });
    });
  })();
</script>

<aside
  data-variant-switcher
  aria-label="Booking variants (dev)"
  class="fixed bottom-4 left-4 z-[1000] rounded-lg border border-gray-300 bg-white/95 p-3 font-mono text-xs text-black shadow-lg"
>
  <p class="mb-2 font-bold">Booking variants (dev)</p>
  {groups.map(([group, values]) => (
    <label class="mb-1 flex items-center justify-between gap-2">
      <span>{group}</span>
      <select name={group} class="rounded border border-gray-300 px-1 py-0.5">
        {values.map((value) => (
          <option value={value}>{value}{value === BOOKING[group] ? " *" : ""}</option>
        ))}
      </select>
    </label>
  ))}
  <button type="button" data-variant-reset class="mt-1 underline">reset to defaults (*)</button>
</aside>
