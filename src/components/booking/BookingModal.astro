---
import BookingPanel from "./BookingPanel.astro";
import { COVERMANAGER_FRAME_ID } from "../../lib/booking";
import { t } from "../../i18n/translations";

interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;
const i18n = t(lang);
---

<dialog
  data-booking-dialog
  aria-labelledby="booking-dialog-title"
  class="fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none overflow-y-auto overscroll-contain bg-brand-cream p-0 text-brand-brown"
>
  <div class="sticky top-0 z-10 flex justify-end bg-brand-cream p-3 sm:p-4 xxl:p-8">
    <button
      type="button"
      data-booking-close
      aria-label={i18n.booking.close}
      title={i18n.booking.close}
      class="rounded p-2 transition-opacity duration-200 hover:opacity-60 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-brown"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="size-6 xxl:size-10 xxxl:size-14"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
  <div data-booking-dialog-body>
    <template data-booking-template>
      <BookingPanel
        lang={lang}
        headingId="booking-dialog-title"
        frameId={`${COVERMANAGER_FRAME_ID}-dialog`}
        loading="eager"
      />
    </template>
  </div>
</dialog>

<script>
  import { initBookingFrames } from "../../lib/booking-resizer";

  const dialog = document.querySelector<HTMLDialogElement>("[data-booking-dialog]");

  if (dialog) {
    const body = dialog.querySelector<HTMLElement>("[data-booking-dialog-body]")!;
    const template = dialog.querySelector<HTMLTemplateElement>("[data-booking-template]");

    const open = () => {
      if (template && !body.querySelector("iframe")) {
        body.appendChild(template.content.cloneNode(true));
      }
      // Close the mobile menu if the dialog was opened from it
      document.getElementById("mobile-menu")?.classList.add("hidden");
      document.querySelector("[data-mobile-toggle]")?.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "hidden";
      dialog.showModal();
      initBookingFrames(dialog);
    };

    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
    });

    dialog.querySelector("[data-booking-close]")?.addEventListener("click", () => dialog.close());

    document.addEventListener("click", (e) => {
      if (document.documentElement.dataset.reserva !== "modal") return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const link = (e.target as Element | null)?.closest?.("[data-booking-link]");
      if (!link) return;
      e.preventDefault();
      open();
    });
  }
</script>
